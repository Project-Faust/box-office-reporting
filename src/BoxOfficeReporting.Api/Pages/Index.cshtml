@page
@model IndexModel
@{
  ViewData["Title"] = "Box Office Reporting";
}

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Box Office Reporting API</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="https://accounts.google.com/gsi/client" async></script>

    <script>
      function decodeJWT(token) {
        let base64Url = token.split(".")[1];
        let base64 = base64Url.replace(/-/g, "+").replace(/_/g, "/");
        let jsonPayload = decodeURIComponent(
          atob(base64)
            .split("")
            .map(function (c) {
              return "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2);
            })
            .join(""),
        );
        return JSON.parse(jsonPayload);
      }

      function handleCredentialResponse(response) {
        console.log("Encoded JWT ID token: " + response.credential);

        const responsePayload = decodeJWT(response.credential);

        console.log("Decoded JWT ID token fields:");
        console.log("  Full Name: " + responsePayload.name);
        console.log("  Given Name: " + responsePayload.given_name);
        console.log("  Family Name: " + responsePayload.family_name);
        console.log("  Unique ID: " + responsePayload.sub);
        console.log("  Profile image URL: " + responsePayload.picture);
        console.log("  Email: " + responsePayload.email);
      }
    </script>
  </head>
  <body>
    <main>
      <div>
        <h1>🎬 Box Office Reporting API</h1>
        <p>
          This application is meant for the storage and analysis of box office
          revenue by authorized users. Please sign in to visit the dashboard.
        </p>
        <p>
          <a href="/auth/login">
            <button type="button" disabled>Sign in with Google</button>
          </a>
        </p>
        <p>Sign in is currently under maintenance.</p>
        <!-- g_id_onload contains Google Identity Services settings -->
        <div
          id="g_id_onload"
          data-auto_prompt="false"
          data-callback="handleCredentialResponse"
          data-client_id="799518914135-tlp15nchq10csia3sksf8495ksb8oj3e.apps.googleusercontent.com"
        ></div>
        <!-- g_id_signin places the button on a page and supports customization -->
        <div class="g_id_signin"></div>
        <p>System status: <code>/health</code></p>
      </div>
    </main>
  </body>
</html>
