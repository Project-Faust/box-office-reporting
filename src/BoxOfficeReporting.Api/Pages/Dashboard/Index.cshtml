@page
@model BoxOfficeReporting.Api.Pages.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <h1 class="mb-4">Dashboard</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Last 7 Days</h2>
                    <p class="mb-1"><strong>Reports:</strong> @Model.WeekSummary.TotalReports</p>
                    <p class="mb-1"><strong>Tickets:</strong> @Model.WeekSummary.TotalTicketsSold</p>
                    <p class="mb-1"><strong>Gross:</strong> @Model.WeekSummary.TotalGross.ToString("C")</p>
                    <p class="mb-1"><strong>Deductions:</strong> @Model.WeekSummary.TotalDeductions.ToString("C")</p>
                    <p class="mb-0"><strong>Net:</strong> @Model.WeekSummary.TotalNet.ToString("C")</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Last 30 Days</h2>
                    <p class="mb-1"><strong>Reports:</strong> @Model.MonthSummary.TotalReports</p>
                    <p class="mb-1"><strong>Tickets:</strong> @Model.MonthSummary.TotalTicketsSold</p>
                    <p class="mb-1"><strong>Gross:</strong> @Model.MonthSummary.TotalGross.ToString("C")</p>
                    <p class="mb-1"><strong>Deductions:</strong> @Model.MonthSummary.TotalDeductions.ToString("C")</p>
                    <p class="mb-0"><strong>Net:</strong> @Model.MonthSummary.TotalNet.ToString("C")</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">This Year</h2>
                    <p class="mb-1"><strong>Reports:</strong> @Model.YearSummary.TotalReports</p>
                    <p class="mb-1"><strong>Tickets:</strong> @Model.YearSummary.TotalTicketsSold</p>
                    <p class="mb-1"><strong>Gross:</strong> @Model.YearSummary.TotalGross.ToString("C")</p>
                    <p class="mb-1"><strong>Deductions:</strong> @Model.YearSummary.TotalDeductions.ToString("C")</p>
                    <p class="mb-0"><strong>Net:</strong> @Model.YearSummary.TotalNet.ToString("C")</p>
                </div>
            </div>
        </div>
    </div>
  @if (Model.Last30Days == null || !Model.Last30Days.Any())
  {
     <div class="card shadow-sm">
          <div class="card-body">
              <h2 class="h5 mb-3">Recent 30-Day Trends</h2>
              <p class="mb-0 text-muted">No report data is available yet.</p>
          </div>
      </div>
  }
  else
  {
      <div class="row g-3">
        <div class="col-12">
          <div class="card shadow-sm">
            <div class="card-body">
              <h2 class="h5 mb-3">Revenue - Last 30 Days</h2>
              <canvas id="netTrendChart"></canvas>
             </div>
           </div>
        </div>

        <div class="col-12">
          <div class="card shadow-sm">
            <div class="card-body">
              <h2 class="h5 mb-3">Tickets Sold - Last 30 Days</h2>
              <canvas id="ticketsTrendChart"></canvas>
            </div>
          </div>
        </div>
    </div>
  }
  </div>

  @section Scripts {
    @if (Model.Last30Days != null && Model.Last30Days.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const labels = @Html.Raw(Model.Last30DayLabelsJson);
            const ticketsData = @Html.Raw(Model.Last30DayTicketsJson);
            const netData = @Html.Raw(Model.Last30DayNetJson);
            const grossData = @Html.Raw(Model.Last30DayGrossJson);

            const netCtx = document.getElementById('netTrendChart');

            new Chart(netCtx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Net Revenue',
                        data: netData,
                        tension: 0.2
                    },
                    {
                        label: 'Gross Revenue',
                        data: grossData,
                        tension: 0.2
                      }]
                },
                options: {
    responsive: true,
    scales: {
        y: {
            ticks: {
                callback: function(value) {
                    return '$' + value;
                }
            }
        }
    },
    plugins: {
        tooltip: {
            callbacks: {
                label: function(context) {
                    return '$' + context.raw.toLocaleString();
                }
            }
        }
    }
}
            });

            const ticketsCtx = document.getElementById('ticketsTrendChart');
            new Chart(ticketsCtx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Tickets Sold',
                        data: ticketsData
                    }]
                },
                options: {
    responsive: true,
    plugins: {
        tooltip: {
            callbacks: {
                label: function(context) {
                    return 'Tickets: ' + context.raw;
                }
            }
        }
    }
}
            });
        </script>
    }
}
