<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Box Office Reporting</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/index.css" />
</head>

<body>
    <header class="site-header">
        <div class="header-shell">
            <div class="topbar">
                <div class="brand-block">
                    <div class="brand">🎬 Box Office Reporting</div>
                    <div class="brand-subtitle">Internal reporting and revenue tracking</div>
                </div>

                <div class="auth-panel">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="user-chip">
                            <span class="user-chip-label">Signed in as</span>
                            <span class="user-chip-name">@User.Identity.Name</span>
                        </div>

                        <form method="post" asp-page="/Account/Logout" class="auth-form">
                            <button type="submit">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Account/Login" class="btn btn-secondary">Sign in</a>
                    }
                </div>
            </div>

            <nav class="nav-row" aria-label="Primary">
                <a asp-page="/Index" class="nav-link">Home</a>
                <a asp-page="/Dashboard/Index" class="nav-link">Dashboard</a>
                <a asp-page="/Reports/Index" class="nav-link">Reports</a>
            </nav>
        </div>
    </header>

    <main class="page-shell">
        <div class="page-card">
            @RenderBody()
        </div>
        @RenderSection("Scripts", required: false)
    </main>
</body>
</html>
