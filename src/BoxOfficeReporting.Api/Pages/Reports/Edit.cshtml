@page "{id:int}"
@model BoxOfficeReporting.Api.Pages.Reports.EditModel

@{
    ViewData["Title"] = "Edit Report";
}

<h1>Edit Report</h1>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />

    <div asp-validation-summary="ModelOnly"></div>

    <fieldset>
        <legend>Report Details</legend>

        <div>
            <label asp-for="Input.ReportDate"></label><br />
            <input asp-for="Input.ReportDate" />
            <span asp-validation-for="Input.ReportDate"></span>
        </div>

        <div>
            <label asp-for="Input.TicketsSold"></label><br />
            <input asp-for="Input.TicketsSold" />
            <span asp-validation-for="Input.TicketsSold"></span>
        </div>

        <div>
            <label asp-for="Input.PricePerTicket"></label><br />
            <input asp-for="Input.PricePerTicket" />
            <span asp-validation-for="Input.PricePerTicket"></span>
        </div>
    </fieldset>

    <hr />

    <fieldset>
        <legend>Events</legend>

        <div>
            <strong>Event 1</strong><br />
            <label asp-for="Input.EventName1">Name</label><br />
            <input asp-for="Input.EventName1" /><br />

            <label asp-for="Input.DeductionPercent1">Deduction %</label><br />
            <input asp-for="Input.DeductionPercent1" />
            <span asp-validation-for="Input.DeductionPercent1"></span>
        </div>

        <br />

        <div>
            <strong>Event 2</strong><br />
            <label asp-for="Input.EventName2">Name</label><br />
            <input asp-for="Input.EventName2" /><br />

            <label asp-for="Input.DeductionPercent2">Deduction %</label><br />
            <input asp-for="Input.DeductionPercent2" />
            <span asp-validation-for="Input.DeductionPercent2"></span>
        </div>
    </fieldset>

    <br />

    <button type="submit">Save Changes</button>
    <a asp-page="/Reports/Index">Cancel</a>
</form>
