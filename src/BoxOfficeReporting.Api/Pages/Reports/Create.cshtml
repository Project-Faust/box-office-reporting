@page
@model BoxOfficeReporting.Api.Pages.Reports.CreateModel

@{
    ViewData["Title"] = "Create Report";
}

<h1>Create Report</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="Input.ReportDate"></label>
        <input asp-for="Input.ReportDate" />
        <span asp-validation-for="Input.ReportDate"></span>
    </div>

    <div>
        <label asp-for="Input.TicketsSold"></label>
        <input asp-for="Input.TicketsSold" />
        <span asp-validation-for="Input.TicketsSold"></span>
    </div>

    <div>
        <label asp-for="Input.PricePerTicket"></label>
        <input asp-for="Input.PricePerTicket" />
        <span asp-validation-for="Input.PricePerTicket"></span>
    </div>

    <hr />

    <h2>Events</h2>

    <div>
        <h3>Event 1</h3>
        <div>
            <label asp-for="Input.EventName1">Event Name</label>
            <input asp-for="Input.EventName1" />
        </div>
        <div>
            <label asp-for="Input.DeductionPercent1">Deduction Percent</label>
            <input asp-for="Input.DeductionPercent1" />
            <span asp-validation-for="Input.DeductionPercent1"></span>
        </div>
    </div>

    <div>
        <h3>Event 2</h3>
        <div>
            <label asp-for="Input.EventName2">Event Name</label>
            <input asp-for="Input.EventName2" />
        </div>
        <div>
            <label asp-for="Input.DeductionPercent2">Deduction Percent</label>
            <input asp-for="Input.DeductionPercent2" />
            <span asp-validation-for="Input.DeductionPercent2"></span>
        </div>
    </div>

    <div>
        <button type="submit">Save</button>
        <a asp-page="Index">Cancel</a>
    </div>
</form>
