@page "{id:int}"
@model BoxOfficeReporting.Api.Pages.Reports.DeleteModel

@{
    ViewData["Title"] = "Delete Report";
}

<div class="page-header">
    <div>
        <p class="eyebrow">Reporting</p>
        <h1 class="page-title">Delete Report</h1>
        <p class="page-intro">Review this report carefully before permanently removing it.</p>
    </div>

    <div class="page-actions">
        <a asp-page="/Reports/Index" class="btn btn-secondary">Back to Reports</a>
    </div>
</div>

<section class="danger-panel">
    <div class="danger-panel-header">
        <h2>Confirm Deletion</h2>
        <p>This action cannot be undone.</p>
    </div>

    <p class="danger-copy">
        Are you sure you want to delete this report?
    </p>
</section>

<section class="detail-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Report Details</p>
            <h2>Summary</h2>
        </div>
    </div>

    <div class="detail-grid">
        <article class="detail-card">
            <span class="detail-label">Date</span>
            <strong class="detail-value">@Model.ReportEntry.ReportDate.ToShortDateString()</strong>
        </article>

        <article class="detail-card">
            <span class="detail-label">Tickets Sold</span>
            <strong class="detail-value">@Model.ReportEntry.TicketsSold</strong>
        </article>

        <article class="detail-card">
            <span class="detail-label">Price Per Ticket</span>
            <strong class="detail-value">@Model.ReportEntry.PricePerTicket.ToString("C")</strong>
        </article>

        <article class="detail-card">
            <span class="detail-label">Gross</span>
            <strong class="detail-value">@Model.ReportEntry.Gross.ToString("C")</strong>
        </article>

        <article class="detail-card">
            <span class="detail-label">Total Deduction</span>
            <strong class="detail-value">@Model.ReportEntry.TotalDeductionAmount.ToString("C")</strong>
        </article>

        <article class="detail-card detail-card-net">
            <span class="detail-label">Net</span>
            <strong class="detail-value">@Model.ReportEntry.Net.ToString("C")</strong>
        </article>
    </div>
</section>

<section class="detail-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Events</p>
            <h2>Associated Event Deductions</h2>
        </div>
    </div>

    @if (Model.ReportEntry.Events != null && Model.ReportEntry.Events.Any())
    {
        <div class="event-card-grid">
            @foreach (var ev in Model.ReportEntry.Events)
            {
                <article class="event-card">
                    <div class="event-card-header">
                        <h3>@ev.EventName</h3>
                        <p>Deduction configuration</p>
                    </div>

                    <div class="detail-stack">
                        <div class="detail-row">
                            <span class="detail-label">Deduction Percent</span>
                            <strong class="detail-value accent-value">@ev.DeductionPercent%</strong>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-state compact-empty-state">
            <p>No events were attached to this report.</p>
        </div>
    }
</section>

<form method="post" class="form-actions">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Delete Report</button>
    <a asp-page="/Reports/Index" class="btn btn-secondary">Cancel</a>
</form>
